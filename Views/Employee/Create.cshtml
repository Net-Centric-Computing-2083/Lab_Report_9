@model Lab9.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<h2>Employee Input Form</h2>

<form asp-controller="Employee" asp-action="Create" method="post">

    <div>
        <label asp-for="Id"></label>
        <input asp-for="Id" />
    </div>

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" />
        <span asp-validation-for="Age"></span>
    </div>

    <div>
        <label asp-for="ContactNo"></label>
        <input asp-for="ContactNo" />
        <span asp-validation-for="ContactNo"></span>
    </div>

    <div>
        <label asp-for="Salary"></label>
        <input asp-for="Salary" type="number" step="0.01" />
    </div>

    <div>
        <label asp-for="JoinedDate"></label>
        <input asp-for="JoinedDate" type="date" />
    </div>

    <br />

    <button type="submit">Submit</button>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}