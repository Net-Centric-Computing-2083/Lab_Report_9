@model Lab_Report_9.Models.Employee

<h2>Employee Registration Form</h2>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="Id"></label>
        <input asp-for="Id" />
    </div>
    <br />

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
    </div>
    <br />

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
    </div>
    <br />

    <div>
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" />
    </div>
    <br />

    <div>
        <label asp-for="ContactNo"></label>
        <input asp-for="ContactNo" />
    </div>
    <br />

    <div>
        <label asp-for="Salary"></label>
        <input asp-for="Salary" type="number" />
    </div>
    <br />

    <div>
        <label asp-for="JoinedDate"></label>
        <input asp-for="JoinedDate" type="date" />
    </div>
    <br />

    <button type="submit">Submit</button>

</form>