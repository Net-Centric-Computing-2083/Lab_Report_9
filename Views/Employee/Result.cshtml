@model Lab9.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h2>Submitted Employee Information</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>Id</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Age</th>
        <td>@Model.Age</td>
    </tr>

    <tr>
        <th>Contact No</th>
        <td>@Model.ContactNo</td>
    </tr>

    <tr>
        <th>Salary</th>
        <td>@Model.Salary</td>
    </tr>

    <tr>
        <th>Joined Date</th>
        <td>@Model.JoinedDate.ToString("yyyy-MM-dd")</td>
    </tr>
</table>

<br />

<a asp-controller="Employee" asp-action="Create">
    Enter Another Employee
</a>