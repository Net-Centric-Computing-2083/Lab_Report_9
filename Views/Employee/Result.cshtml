@model Lab_Report_9.Models.Employee

<h2>Submitted Employee Details</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>Employee ID</th>
        <td>@Model.Id</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <th>Age</th>
        <td>@Model.Age</td>
    </tr>
    <tr>
        <th>Contact No</th>
        <td>@Model.ContactNo</td>
    </tr>
    <tr>
        <th>Salary</th>
        <td>@Model.Salary</td>
    </tr>
    <tr>
        <th>Joined Date</th>
        <td>@Model.JoinedDate.ToString("yyyy-MM-dd")</td>
    </tr>
</table>

<br />

<a asp-action="Create">Add Another Employee</a>