@model LabReport9.Models.Employee

<!DOCTYPE html>
<html>
<head>
    <title>Employee Result</title>

  
</head>

<body>

    <div class="container">

        <h1>Submitted Employee Details</h1>

        <div class="detail">
            <span class="label">Employee ID:</span>
            @Model.Id
        </div>

        <div class="detail">
            <span class="label">Name:</span>
            @Model.Name
        </div>

        <div class="detail">
            <span class="label">Email:</span>
            @Model.Email
        </div>

        <div class="detail">
            <span class="label">Age:</span>
            @Model.Age
        </div>

        <div class="detail">
            <span class="label">Contact No:</span>
            @Model.ContactNo
        </div>

        <div class="detail">
            <span class="label">Salary:</span>
            @Model.Salary
        </div>

        <div class="detail">
            <span class="label">Joined Date:</span>
            @Model.JoinedDate.ToString("yyyy-MM-dd")
        </div>

    </div>

</body>
</html>