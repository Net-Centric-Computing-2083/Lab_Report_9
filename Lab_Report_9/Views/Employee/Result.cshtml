@model Lab_Report_9.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-5">

    <h2>Submitted Employee Information</h2>
    <hr />

    <table class="table table-bordered">

        <tr>
            <th>Employee ID</th>
            <td>@Model.Id</td>
        </tr>

        <tr>
            <th>Name</th>
            <td>@Model.Name</td>
        </tr>

        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>

        <tr>
            <th>Age</th>
            <td>@Model.Age</td>
        </tr>

        <tr>
            <th>Contact No</th>
            <td>@Model.ContactNo</td>
        </tr>

        <tr>
            <th>Salary</th>
            <td>Rs. @Model.Salary</td>
        </tr>

        <tr>
            <th>Joined Date</th>
            <td>@Model.JoinedDate.ToString("yyyy-MM-dd")</td>
        </tr>

    </table>

    <a asp-action="Create" class="btn btn-secondary">
        Back to Form
    </a>

</div>