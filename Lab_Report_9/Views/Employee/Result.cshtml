@model ModelBindingDemo.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h1>Employee Details</h1>

<table class="table table-bordered">

    <tr>
        <th>Employee ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Age</th>
        <td>@Model.Age</td>
    </tr>

    <tr>
        <th>Contact Number</th>
        <td>@Model.ContactNo</td>
    </tr>

    <tr>
        <th>Salary</th>
        <td>@Model.Salary</td>
    </tr>

    <tr>
        <th>Joined Date</th>
        <td>@Model.JoinedDate.ToString("yyyy-MM-dd")</td>
    </tr>

</table>

<a asp-controller="Employee"
   asp-action="Create"
   class="btn btn-primary">
    Back
</a>