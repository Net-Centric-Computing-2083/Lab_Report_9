@model Lab_Report_9.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<h2>Create Employee</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Id" class="form-label">Employee ID</label>
        <input asp-for="Id" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" type="email" />
    </div>

    <div class="mb-3">
        <label asp-for="Age" class="form-label">Age</label>
        <input asp-for="Age" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="ContactNo" class="form-label">Contact No</label>
        <input asp-for="ContactNo" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Salary" class="form-label">Salary</label>
        <input asp-for="Salary" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="JoinedDate" class="form-label">Joined Date</label>
        <input asp-for="JoinedDate" class="form-control" type="date" />
    </div>

    <button type="submit" class="btn btn-primary">
        Submit
    </button>

</form> 