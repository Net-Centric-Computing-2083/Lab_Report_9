@model MyMvcApp.Models.Employee

<!DOCTYPE html>
<html>
<head>
    <title>Create Employee</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                background-color: #f2f2f2;
                margin: 0;
                padding: 40px;
            }

            .form-container {
                width: 450px;
                margin: auto;
                background: white;
                padding: 25px;
                border-radius: 10px;
                box-shadow: 0 0 10px gray;
            }

            h2 {
                text-align: center;
            }

            .form-group {
                margin-bottom: 15px;
            }

            label {
                display: block;
                margin-bottom: 5px;
                font-weight: bold;
            }

            input {
                width: 100%;
                padding: 9px;
                box-sizing: border-box;
                border: 1px solid #ccc;
                border-radius: 5px;
            }

            button {
                width: 100%;
                padding: 10px;
                background-color: #007bff;
                color: white;
                border: none;
                border-radius: 5px;
                cursor: pointer;
            }

            button:hover {
                background-color: #0056b3;
            }

            .error {
                color: red;
            }
    </style>
</head>

<body>

    <div class="form-container">

        <h2>Employee Registration Form</h2>

        <form asp-controller="Employee"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All" class="error"></div>

            <div class="form-group">
                <label asp-for="Id">Employee ID</label>
                <input asp-for="Id" />
            </div>

            <div class="form-group">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" />
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" />
            </div>

            <div class="form-group">
                <label asp-for="Age">Age</label>
                <input asp-for="Age" type="number" />
            </div>

            <div class="form-group">
                <label asp-for="ContactNo">Contact No</label>
                <input asp-for="ContactNo" />
            </div>

            <div class="form-group">
                <label asp-for="Salary">Salary</label>
                <input asp-for="Salary" type="number" step="0.01" />
            </div>

            <div class="form-group">
                <label asp-for="JoinedDate">Joined Date</label>
                <input asp-for="JoinedDate" type="date" />
            </div>

            <button type="submit">Submit</button>

        </form>

    </div>

</body>
</html>